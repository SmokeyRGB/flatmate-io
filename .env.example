# TWO PROJECTS, since 2026-09-18. `flatmate-io-dev` is what local work and CI point at;
# `flatmate-io` is production and the test suite refuses to touch it (tests/setup.ts). The suite
# creates real households and real Auth users, its cleanup is best-effort, and activity_event is
# append-only — so pointing this file at production means writing rows nothing can remove.
#
# A fresh project needs scripts/db/bootstrap-roles.sql run once as postgres BEFORE the drizzle/
# chain, then the app_runtime password set by hand. See that file's header.
#
# Transaction-mode Supavisor pooler (port 6543), per docs/adr/0006-*.md ("Änderung 2026-09-16")
# and research.md §1 — required because the app runs serverless/edge on Vercel and cannot hold a
# long-lived direct connection. Prepared statements MUST be disabled on the client
# (`postgres(connectionString, { prepare: false })`) or writes fail unpredictably.
#
# Connect as app_runtime, never postgres (G-C2 — the app's role must not own the tables it
# queries, or RLS silently no-ops for it). Get the exact host (the aws-N cluster index is not
# derivable from the region — copy it from Supabase's own Connect dialog, don't compose it
# yourself) and project ref from the Supabase Dashboard's Connect panel, Transaction pooler tab.
#
# No real values committed here (G-A2) — every placeholder below must be replaced locally, and
# none of this file's values should ever be committed back with real ones.
DATABASE_URL="postgres://app_runtime.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:6543/postgres"

# Supabase Auth (ADR-006) — from the project's API settings (Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Supabase Auth admin API (F1, src/modules/identity/auth.ts) — creates accounts, including the
# derived-email resident accounts (research.md §2). SERVER-ONLY: never reference this in a client
# component, never prefix it NEXT_PUBLIC_*, never log it (G-A3/G-A4). Distinct from the anon key
# above, which is safe for the browser; this one is not.
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# HMAC key for Session.token_hash (src/modules/identity/auth.ts, hashSessionToken) — never the
# access token itself, only a keyed digest of it (docs/GUARDRAILS.md token_hash rule). SERVER-ONLY,
# generate a random secret per environment, never reuse across environments, never commit a real
# value here (G-A2/G-A3).
SESSION_TOKEN_HASH_SECRET="[YOUR-RANDOM-SECRET]"

# FR-2.28: which request header, if any, may be believed as the client address for the join
# route's attempt limit. LEAVE IT UNSET unless a proxy in front of this app overwrites the
# header named here and strips it from inbound requests. Unset means every request shares one
# bucket and the limit is global — conservative, and the truth in local development. Set to a
# client-settable header with no proxy in front and the limit can be bypassed entirely by
# rotating its value (see src/app/(auth)/join/[code]/request-ip.ts).
# Vercel, for example: JOIN_ATTEMPT_TRUSTED_IP_HEADER="x-vercel-forwarded-for"
# JOIN_ATTEMPT_TRUSTED_IP_HEADER=""
